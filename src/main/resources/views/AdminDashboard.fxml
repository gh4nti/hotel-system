<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
       fx:controller="com.hotel.controllers.AdminController"
       styleClass="page-root">

  <VBox spacing="12" alignment="CENTER" maxWidth="380" styleClass="card">
    <Label text="Admin Dashboard" styleClass="section-title"/>
    <Label fx:id="welcomeLabel" styleClass="subtitle" />

    <Label text="Room inventory is pre-generated and automatically managed." styleClass="info-label" wrapText="true" />
    <Button text="Modify Room" onAction="#handleModifyRoom" styleClass="secondary-button" />
    <Button text="View Rooms" onAction="#handleViewRooms" styleClass="primary-button"/>
    <Region VBox.vgrow="ALWAYS" />
    <Button text="Log Out" onAction="#handleLogout" styleClass="secondary-button" />
  </VBox>

</StackPane>