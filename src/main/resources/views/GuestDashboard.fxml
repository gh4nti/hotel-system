<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
       styleClass="page-root">

  <VBox spacing="12" alignment="CENTER" maxWidth="380" styleClass="card">
    <Label text="Guest Dashboard" styleClass="section-title" />
    <Label text="Browse and reserve available rooms." styleClass="subtitle" />

    <Button text="View Rooms" styleClass="primary-button" />
    <Button text="Book Room" styleClass="secondary-button" />
  </VBox>

</StackPane>