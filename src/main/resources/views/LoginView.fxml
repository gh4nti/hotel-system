<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
       fx:controller="com.hotel.controllers.LoginController"
       styleClass="page-root">

    <VBox spacing="15" alignment="CENTER" maxWidth="360" styleClass="card">

    <Label text="Hotel Login" styleClass="screen-title"/>
        <Label text="Welcome back. Sign in to continue." wrapText="true" styleClass="subtitle"/>

        <TextField fx:id="usernameField" promptText="Username"/>
        <PasswordField fx:id="passwordField" promptText="Password" onAction="#handleLogin"/>

    <Button text="Login" onAction="#handleLogin" styleClass="primary-button"/>

    <Label fx:id="messageLabel" styleClass="info-label"/>

    </VBox>

</StackPane>