<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hotel.controllers.ViewRoomsController"
           styleClass="page-root">

    <VBox spacing="15" alignment="CENTER" maxWidth="650" styleClass="card">
        <Label text="All Rooms" styleClass="section-title" />
        <Label text="Select an available room to continue." styleClass="subtitle" />

        <Button text="Back to Dashboard" onAction="#handleBack" styleClass="secondary-button" />

        <TableView fx:id="table" prefWidth="560" prefHeight="320">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="170"/>
                <TableColumn fx:id="priceCol" text="Price" prefWidth="150"/>
                <TableColumn fx:id="availCol" text="Available" prefWidth="170"/>
            </columns>
        </TableView>

        <Button text="Book Selected Room" onAction="#handleBook" styleClass="primary-button"/>
    </VBox>

</StackPane>