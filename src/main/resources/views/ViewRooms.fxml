<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hotel.controllers.ViewRoomsController"
           styleClass="page-root">

    <VBox spacing="15" alignment="CENTER" maxWidth="650" styleClass="card">
        <Label text="All Rooms" styleClass="section-title" />
        <Label text="Select a room type and the system will assign an available room automatically." styleClass="subtitle" />
        <Label fx:id="summaryLabel" styleClass="info-label" wrapText="true" />

        <HBox spacing="10" alignment="CENTER">
            <Label text="Book by type:" styleClass="info-label" />
            <ComboBox fx:id="typeCombo" prefWidth="220" />
            <Button text="Book Room" onAction="#handleBook" styleClass="primary-button" />
        </HBox>

        <Button text="Back to Dashboard" onAction="#handleBack" styleClass="secondary-button" />

        <TableView fx:id="table" prefWidth="560" prefHeight="320">
            <columns>
                <TableColumn fx:id="roomNumberCol" text="Room #" prefWidth="100"/>
                <TableColumn fx:id="floorCol" text="Floor" prefWidth="70"/>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="170"/>
                <TableColumn fx:id="priceCol" text="Price" prefWidth="120"/>
                <TableColumn fx:id="availCol" text="Available" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

</StackPane>